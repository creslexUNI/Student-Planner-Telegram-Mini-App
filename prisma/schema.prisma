// Prisma schema for Student Planner
// Models: User, Session, Group, GroupMember, Lesson, Homework, HomeworkProgress, Task

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  university   String?
  faculty      String?
  course       Int?
  groupName    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  memberships      GroupMember[]
  sessions         Session[]
  tasks            Task[]
  lessons          Lesson[]
  homeworkProgress HomeworkProgress[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

model Group {
  id         String        @id @default(cuid())
  name       String
  inviteCode String        @unique
  createdAt  DateTime      @default(now())

  members   GroupMember[]
  lessons   Lesson[]
  homeworks Homework[]

  @@map("groups")
}

enum GroupRole {
  ADMIN
  HEADMAN
  MEMBER
}

model GroupMember {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
  @@map("group_members")
}

enum LessonType {
  lecture
  practice
  lab
}

model Lesson {
  id           String     @id @default(cuid())
  groupId      String?
  group        Group?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      String
  type         LessonType @default(lecture)
  teacher      String
  room         String
  dayOfWeek    String     // "monday", "tuesday", etc.
  weekType     String     @default("both") // "odd", "even", "both"
  startTime    String     // "08:30"
  endTime      String     // "10:05"
  specificDate String?    // Optional specific calendar date "YYYY-MM-DD"
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([groupId])
  @@index([userId])
  @@index([specificDate])
  @@map("lessons")
}

model Homework {
  id             String             @id @default(cuid())
  groupId        String
  group          Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject        String
  title          String
  description    String
  deadline       DateTime
  author         String             @default("Староста")
  attachmentName String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  progress       HomeworkProgress[]
  tasks          Task[]

  @@index([groupId])
  @@index([deadline])
  @@map("homeworks")
}

enum HomeworkStatus {
  pending
  in_progress
  urgent
  completed
}

model HomeworkProgress {
  id         String         @id @default(cuid())
  homeworkId String
  homework   Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     HomeworkStatus @default(pending)
  updatedAt  DateTime       @updatedAt

  @@unique([homeworkId, userId])
  @@index([userId])
  @@map("homework_progress")
}

enum TaskPriority {
  low
  medium
  high
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  completed   Boolean      @default(false)
  priority    TaskPriority @default(medium)
  category    String?      // "Учёба", "Деканат", "Проект", "Личное"
  deadline    DateTime?
  homeworkId  String?
  homework    Homework?    @relation(fields: [homeworkId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@index([completed])
  @@map("tasks")
}
