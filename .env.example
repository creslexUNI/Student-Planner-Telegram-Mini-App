# PostgreSQL connection string (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://student_user:your_secure_password@localhost:5432/student_planner?schema=public"

# Node.js runtime environment (development | production)
NODE_ENV="development"

# Port for Express HTTP server (default 3000)
PORT="3000"

# Secret string used for cookie session signature (min 32 characters)
SESSION_SECRET="change-this-to-a-very-secure-random-secret-key"

# AI Studio runtime variables (injected automatically in cloud environment)
APP_URL="MY_APP_URL"
